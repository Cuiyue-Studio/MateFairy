                asset texturePath = @../Assets/museum_day_ibl.exr@
                token textureShape = "TEXTURE_CUBEMAP"
                token textureType = "DEFAULT"
            }
        }
    }

    def "Football" (
        prepend references = @../Assets/Football.usdz@
    )
    {
        quatf xformOp:orient = (0.7071068, -0.7071067, 0, 0)
