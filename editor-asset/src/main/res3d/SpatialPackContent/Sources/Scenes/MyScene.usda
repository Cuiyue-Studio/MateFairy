    upAxis = "Y"
)

def Xform "Root"
{
    quatf xformOp:orient = (1, 0, 0, 0) (
        customData = {
            float3 euler = (0, 0, 0)
        }
    )
    float3 xformOp:scale = (1, 1, 1)
    float3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Xform "SpotLight"
    {
        token visibility = "inherited"
        quatf xformOp:orient = (0.7071068, -0.7071067, 0, 0) (
            customData = {
                float3 euler = (-90, 0, 0)
            }
        )
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def SpatialComponent "SpotLightComponent"
        {
            uniform token info:id = "SpotLightComponent"
            uint64 info:typeId = 2546492886525202599
        }
    }

    def Xform "IBL"
    {
        token visibility = "inherited"
        quatf xformOp:orient = (0.89299095, -0.41944683, 0.14327785, -0.078121655) (
            customData = {
                float3 euler = (-46.613678, 27.899996, -22.215746)
            }
        )
        float3 xformOp:scale = (0.9999998, 0.99999994, 0.99999994)
        float3 xformOp:translate = (0.21276706, 0.47131893, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def SpatialComponent "StageEnvironmentLightingComponent"
        {
            uniform token info:id = "StageEnvironmentLightingComponent"
            uint64 info:typeId = 8323998322427533274
            token mMode = "SINGLE"

            def SpatialStruct "mIblTextureOne"
            {
                bool generateMipmap = 1
                uint64 info:typeId = 7057009229666234536
                token maxSize = "MAXSIZE_256"
                token mipmapMode = "ENV_LIGHTING"
                token sourceColorSpace = "SRGB_REC709"
                token targetColorSpace = "SRGB_DISPLAY_P3"
